# Both variables are server-only. Never use NEXT_PUBLIC_ for access tokens or secrets.
# Existing .NET 10 API locally:
API_BASE_URL=http://localhost:5090
# Browser-facing origin. REQUIRED in production: use your real HTTPS host.
APP_ORIGIN=http://localhost:3000

# Optional PUBLIC presentation data, set separately for each venue deployment.
# These values are developer/operator-managed, not owner-editable in /admin.
# Omit values until you have real approved court photos and contact details.
VENUE_PHONE=
VENUE_FACEBOOK_URL=
# JSON array of 3–6 real images from frontend/public/venue:
# VENUE_GALLERY_JSON='[{"src":"/venue/court-1.webp","alt":"Main pickleball court"}]'
VENUE_GALLERY_JSON=[]

# Payment details are HIDDEN until explicitly approved by the venue operator.
# Never turn this on with sample or unverified account details.
VENUE_PAYMENT_INSTRUCTIONS_APPROVED=false
VENUE_GCASH_NAME=
VENUE_GCASH_NUMBER=
VENUE_GCASH_QR_PATH=
VENUE_BANK_NAME=
VENUE_BANK_ACCOUNT_NAME=
VENUE_BANK_ACCOUNT_NUMBER=
VENUE_BANK_QR_PATH=
