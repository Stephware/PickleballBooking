# Both variables are server-only. Never use NEXT_PUBLIC_ for access tokens or secrets.
# Existing .NET 10 API locally:
API_BASE_URL=http://localhost:5090
# Browser-facing origin. REQUIRED in production: use your real HTTPS host.
APP_ORIGIN=http://localhost:3000

# Venue appearance. This repository defaults to the approved Pickleball Reserve
# burgundy/cream theme and bundled local logo. Use VENUE_BRAND_MODE=api when
# deploying a different venue to respect its backend name/colors/logo.
# The shared Reserve-style layout is reusable for five venue palettes.
# 'api' mode keeps the backend identity instead of applying a named preset.
# Pick one of: pickleball-reserve, the-pickle-cave, the-mad-pickle,
# trnd-pickleball, angeles-pickleball-center
# This affects frontend branding ONLY, not backend data tenancy.
VENUE_BRAND_MODE=reserve
VENUE_TEMPLATE=pickleball-reserve
VENUE_BRAND_PRIMARY="#80011f"
VENUE_BRAND_SECONDARY="#fff9ed"
# Reserve legacy logo remains in use. New presets automatically discover
# /venues/<slug>/logos/logo.png|jpg|webp (if present).
VENUE_LOGO_PATH=/venue/brand-logo.jpg

# Optional PUBLIC presentation data, set separately for each venue deployment.
# These values are developer/operator-managed, not owner-editable in /admin.
# The supplied Reserve photos appear by default when this variable is omitted.
# VENUE_BRAND_MODE=api never uses Reserve photos as another venue.
VENUE_PHONE=
VENUE_FACEBOOK_URL=
# JSON array of 3–6 real images from frontend/public/venue or
# frontend/public/venues/<selected-slug>/courts/ (scoped to template).
# For other presets, upload court-1.jpg etc. to the dedicated folder to
# display their images automatically without an env JSON configuration.
# The hero is read automatically from /venues/<slug>/hero/hero.jpg etc.
# Omit or use [] to show Reserve photos (compatible with existing config).
# Set VENUE_HIDE_IMPORTED_PHOTOS=true to hide the supplied Reserve assets.
# VENUE_GALLERY_JSON='[{"src":"/venue/court-2.jpg","alt":"Indoor court"}]'
VENUE_HIDE_IMPORTED_PHOTOS=false

# Payment details are HIDDEN until explicitly approved by the venue operator.
# Never turn this on with sample or unverified account details.
VENUE_PAYMENT_INSTRUCTIONS_APPROVED=false
VENUE_GCASH_NAME=
VENUE_GCASH_NUMBER=
VENUE_GCASH_QR_PATH=
VENUE_BANK_NAME=
VENUE_BANK_ACCOUNT_NAME=
VENUE_BANK_ACCOUNT_NUMBER=
VENUE_BANK_QR_PATH=
