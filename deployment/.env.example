# Copy outside Git into a private per-venue environment file; chmod 600.
COMPOSE_PROJECT_NAME=pickleball_venue_a
APP_ORIGIN=https://booking.example.com
FRONTEND_PORT=3000
# Generate independently per venue; never use these placeholders as credentials.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
DB_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
BOOKING_SIGNING_KEY=REPLACE_WITH_PERSISTENT_RANDOM_64_HEX_CHARACTERS
# For rollback, point at immutable commit tags in your private registry.
API_IMAGE=pickleball-api:local
FRONTEND_IMAGE=pickleball-frontend:local

# Each venue needs a distinct, non-overlapping /24 network (first three octets).
VENUE_NETWORK_PREFIX=172.30.91

# Optional PUBLIC venue presentation fields, unique for this deployment.
# Supply only actual venue-approved data; do not expose real receipts here.
VENUE_PHONE=
VENUE_FACEBOOK_URL=
# Pickleball Reserve: omit gallery config to show four supplied court photos.
# Preset deployments can select VENUE_TEMPLATE=<approved-venue-slug>
# and auto-discover approved public media under /venues/<slug>/.
# VENUE_BRAND_MODE=api keeps the backend name/logo/colors instead.
# Previewing different themes against this one backend shares all data;
# use demo-only synthetic data or a separate deployment/database per buyer.
VENUE_BRAND_MODE=reserve
# Choose a theme for THIS frontend deployment; not a database selector.
VENUE_TEMPLATE=pickleball-reserve
VENUE_BRAND_PRIMARY="#80011f"
VENUE_BRAND_SECONDARY="#fff9ed"
VENUE_LOGO_PATH=/venue/brand-logo.jpg
# VENUE_GALLERY_JSON=[]
# Set to true only if this deployment must hide the supplied Reserve photos.
VENUE_HIDE_IMPORTED_PHOTOS=false
# Recipient details remain unpublished unless approved=true AND complete.
VENUE_PAYMENT_INSTRUCTIONS_APPROVED=false
VENUE_GCASH_NAME=
VENUE_GCASH_NUMBER=
VENUE_GCASH_QR_PATH=
VENUE_BANK_NAME=
VENUE_BANK_ACCOUNT_NAME=
VENUE_BANK_ACCOUNT_NUMBER=
VENUE_BANK_QR_PATH=
